# Copie este arquivo para .env e preencha com seus dados reais.
# Nunca commite o .env de verdade no Git.

# Access Token do Mercado Pago (Painel > Suas integrações > Credenciais)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

BASE_URL=http://localhost:3000
PORT=3000

# Número que recebe o relatório diário e os alertas de estoque
DONO_WHATSAPP=5511999999999

# Horários dos agendamentos automáticos (formato cron)
REPORT_CRON_TIME=0 20 * * *
STOCK_CRON_TIME=0 9 * * *

# Credenciais do Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=seu_account_sid_aqui
TWILIO_AUTH_TOKEN=seu_auth_token_aqui
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
